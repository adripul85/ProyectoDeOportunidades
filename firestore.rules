rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario es Admin (usando campo en el documento o custom claim)
    function isAdmin() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) || (userDoc != null && userDoc.data.keys().hasAll(['role']) && userDoc.data.role == 'admin');
    }

    // REGLAS PARA TRANSACCIONES
    match /transactions/{transactionId} {
      // Leer: Comprador, Vendedor o Admin
      allow read: if request.auth != null && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid || 
        isAdmin()
      );
      
      // Crear: Cualquier usuario autenticado puede iniciar un trato
      allow create: if request.auth != null && request.resource.data.buyerId == request.auth.uid;
      
      // Actualizar: PROTECCIÓN CRÍTICA
      allow update: if request.auth != null && (
        isAdmin() || (
          // El usuario solo puede cambiar el estado bajo reglas estrictas (FSM limitado)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'trackingId', 'courier', 'deliveredAt', 'inspectionDeadline', 'disputeReason', 'disputeStartedAt', 'lastSystemMessage', 'isAmicableReturnAccepted']) && (
            // Regla: Pasar a DISPUTED es permitido para Comprador/Vendedor
            (request.resource.data.status == 'DISPUTED' && resource.data.status != 'COMPLETED' && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)) ||
            // Regla: El COMPRADOR libera fondos (Completa el trato)
            (request.resource.data.status == 'COMPLETED' && resource.data.status != 'DISPUTED' && resource.data.buyerId == request.auth.uid) ||
            // Regla: EL VENDEDOR registra envío
            (request.resource.data.status == 'SHIPPED' && resource.data.status == 'PAID_HELD' && resource.data.sellerId == request.auth.uid) ||
            // Regla: Pasar a PAID_HELD (Devolución amigable o pago) suele ser via Admin/CF, pero permitimos retorno amigable
            (request.resource.data.status == 'PAID_HELD' && resource.data.status == 'DISPUTED' && resource.data.sellerId == request.auth.uid && request.resource.data.isAmicableReturnAccepted == true)
          )
        )
      );
      
      allow delete: if isAdmin();
    }
    
    // REGLAS PARA USUARIOS
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Bloquear edición manual de balance, wallet y reputación
      allow update: if request.auth != null && request.auth.uid == userId && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['balance', 'wallet', 'reputation', 'isAdmin', 'role', 'points'])
      ) || isAdmin();
    }

    // REGLAS PARA PRODUCTOS (ITEMS)
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
    }
  }
}
